# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
# Địa chỉ frontend để tạo link trong email mời / đặt lại mật khẩu.
# Bỏ trống thì lấy Cài đặt → Giao diện → Địa chỉ truy cập, rồi tới CORS_ORIGIN
FRONTEND_URL=

# Database (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ehrm
DB_PASSWORD=ehrm123
DB_DATABASE=ehrm
# true: tự đồng bộ schema theo entity (chỉ dùng khi dev). Production: false + dùng migration
DB_SYNC=true
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Thư mục lưu file upload (ảnh, tài liệu)
UPLOAD_DIR=uploads

# Email (SMTP). Bỏ trống MAIL_HOST: email chỉ được ghi ra log, không gửi thật
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASS là App Password
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=eHRM <no-reply@ehrm.local>
